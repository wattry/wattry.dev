{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "calm-cloud-4d4e",
  "main": "workers/src/worker.js",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wattry-typetest",
      "database_id": "579c7380-c9fd-4879-9f62-896408f397bc"
    }
  ],
  "unsafe": {
    "bindings": [
      {
        "name": "SCORE_RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": { "limit": 1, "period": 60 }
      }
    ]
  },
  "workers_dev": true,
  "preview_urls": false,
  "compatibility_date": "2026-07-02",
  "routes": [
    {
      "pattern": "api.wattry.com",
      "zone_name": "wattry.com",
      "custom_domain": true,
      "enabled": true,
      "previews_enabled": false
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}